{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned OpenCode2 container configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["default_agent", "agents", "skills", "mcp", "permissions", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "share": { "enum": ["manual", "auto", "disabled"] },
    "autoupdate": { "type": "boolean" },
    "model": { "$ref": "#/$defs/model" },
    "default_agent": { "type": "string", "minLength": 1 },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agent" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servers"],
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/mcpServer" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/permission" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "model": {
      "type": "string",
      "pattern": "^[^/]+/.+$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": {
        "type": { "const": "local" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "disabled": { "type": "boolean" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource", "effect"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string" },
        "effect": { "enum": ["allow", "deny", "ask"] }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      }
    }
  }
}
