#!/usr/bin/env python3
"""oc2-verify — run workspace verification commands in a disposable worker.

The point of this tool is that the caller never touches the container engine.
It owns the only privileged decision in the design: what a worker container is
allowed to see. Everything else about a verification run — which command, how
long, how much output — is caller-supplied and cannot widen that decision.

Guarantees this tool makes, and how:
  * The workspace enters the worker read-only (`-v <workspace>:/src:ro`) and is
    copied into the worker's own throwaway layer before the command runs. For a
    linked worktree of an enclosing `.bare`, that validated Git common directory
    is additionally mounted read-only and copied into scratch.
    The command gets a writable tree; the real one cannot be written.
  * The worker is started `--rm` from a pinned image with `--pull=never`, so its
    rootfs is discarded on exit and nothing is fetched at run time.
  * No host path other than the workspace and its validated `.bare` Git
    directory is ever mounted; the container engine socket is never mounted.
    A worker that could mount host paths read-write would not be isolated;
    this is the reason the broker exists.
  * The environment is a fixed minimal set. Provider credentials that the agent
    container carries are not forwarded into a container running repo code.
  * Container *creation* is serialized under a lock. Nested engine calls race
    on `ping_group_range` and fail outright when started concurrently; creation
    is where that happens, so only creation holds the lock and runs proceed in
    parallel.

Configuration comes from the sandbox config the launcher already bind-mounts
read-only at /run/opencode/sandbox.json, `verify` block. The launcher reads
config keys individually and does not reject unknown top-level keys, so this
tool validates the block itself and refuses rather than silently falling back to
defaults on a typo.

Usage:
  oc2-verify -- ruff check .
  oc2-verify --check lint
  oc2-verify --json --check tests
  oc2-verify --list

Exit codes: the worker command's exit code on a completed run; 2 for a usage or
configuration error; 124 on timeout; 125 when the run could not be started at
all (missing image, engine failure). A check that cannot run is never reported
as a pass.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
from typing import Any, Final, NamedTuple

SANDBOX_CONFIG: Final[str] = os.environ.get("OPENCODE_SANDBOX_CONFIG", "/run/opencode/sandbox.json")
DEFAULT_IMAGE: Final[str] = "localhost/opencode2-verify:latest"
DEFAULT_TIMEOUT_SECONDS: Final[int] = 300
DEFAULT_MEMORY: Final[str] = "2g"
DEFAULT_CPUS: Final[str] = "2"
DEFAULT_OUTPUT_CAP_BYTES: Final[int] = 200_000

# The worker's in-container scratch. /src is the read-only workspace mount; the
# command runs against the copy, never against /src.
SRC_TARGET: Final[str] = "/src"
SCRATCH: Final[str] = "/tmp/w"
GIT_TARGET: Final[str] = "/git-common"

# Deliberately short. Everything a repo build might need is in the image; the
# agent container's provider keys, session tokens, and OpenCode runtime vars are
# not, and must not reach code fetched from or committed to the workspace.
PASSTHROUGH_ENV: Final[tuple[str, ...]] = ("LANG", "LC_ALL", "TZ")

USAGE_ERROR: Final[int] = 2
TIMEOUT_EXIT: Final[int] = 124
START_FAILED: Final[int] = 125


def die(message: str, code: int = USAGE_ERROR) -> None:
    print(f"oc2-verify: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_verify_config(path: str = SANDBOX_CONFIG) -> dict[str, Any]:
    """Read and validate the `verify` block. Missing file means pure defaults.

    An unreadable or malformed block is an error, not a silent default: a typo
    that quietly dropped `image` would run checks in the wrong toolchain and
    report success. The path is a parameter rather than a module global so this
    stays a pure read that tests can point at a fixture.
    """
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as handle:
            document = json.load(handle)
    except (OSError, json.JSONDecodeError) as error:
        die(f"cannot read {path}: {error}")
    if not isinstance(document, dict):
        die(f"{path} is not a JSON object")
    block = document.get("verify")
    if block is None:
        return {}
    if not isinstance(block, dict):
        die(f"{path}: verify must be an object")

    allowed = {"image", "timeout_seconds", "memory", "cpus", "network", "checks", "output_cap_bytes"}
    unknown = sorted(set(block) - allowed)
    if unknown:
        die(f"{path}: verify has unknown field(s): {', '.join(unknown)}")

    timeout = block.get("timeout_seconds", DEFAULT_TIMEOUT_SECONDS)
    if not isinstance(timeout, int) or isinstance(timeout, bool) or not 1 <= timeout <= 3600:
        die("verify.timeout_seconds must be an integer in 1..3600")
    network = block.get("network", "none")
    if network not in ("none", "slirp4netns", "pasta"):
        die("verify.network must be one of: none, slirp4netns, pasta")
    checks = block.get("checks", {})
    if not isinstance(checks, dict) or not all(
        isinstance(name, str) and isinstance(cmd, str) and cmd.strip() for name, cmd in checks.items()
    ):
        die("verify.checks must map names to non-empty command strings")
    for key in ("image", "memory", "cpus"):
        value = block.get(key)
        if value is not None and not isinstance(value, str):
            die(f"verify.{key} must be a string")
    return block


def resolve_command(args: argparse.Namespace, checks: dict[str, str]) -> str | list[str]:
    """A named check is a shell string; a trailing command stays an argv list."""
    if args.check is not None:
        if args.dash_command:
            die("--check and a trailing command are mutually exclusive")
        if args.check not in checks:
            available = ", ".join(sorted(checks)) or "none configured"
            die(f"unknown check {args.check!r}; configured checks: {available}")
        return checks[args.check]
    if not args.dash_command:
        die("nothing to run: pass --check NAME or a command after --")
    # argparse.REMAINDER keeps the `--` separator itself; it is not part of the command.
    parts = args.dash_command
    while parts and parts[0] == "--":
        parts = parts[1:]
    if not parts:
        die("nothing to run: pass --check NAME or a command after --")
    return list(parts)


def describe_command(command: str | list[str]) -> str:
    """Render the command for reporting so it re-parses to the same argv."""
    if isinstance(command, list):
        return " ".join(shlex.quote(part) for part in command)
    return command


class LinkedGit(NamedTuple):
    """A linked worktree whose Git common directory is a `.bare` enclosing it."""

    common: str    # host path of `<root>/.bare`, mounted read-only
    checkout: str  # the workspace relative to `<root>`
    name: str      # its metadata directory, `.bare/worktrees/<name>`


def read_git_line(path: str, what: str) -> str:
    """One newline-terminated line of Git metadata, refused if it is anything else."""
    if os.path.islink(path) or not os.path.isfile(path):
        die(f"invalid {what}: {path}")
    try:
        with open(path, encoding="utf-8") as handle:
            content = handle.read()
    except (OSError, UnicodeError) as error:
        die(f"cannot read {what}: {error}")
    if not content.endswith("\n") or content.count("\n") != 1:
        die(f"malformed {what}: {path}")
    return content[:-1]


def workspace_git_common(workspace: str) -> LinkedGit | None:
    """Allow only a real .git directory or a linked worktree of an enclosing `.bare`.

    The layout is `<root>/.bare` as the common directory with every worktree
    checked out somewhere under `<root>`. The `.git` pointer selects which
    worktree metadata to check, but it is never trusted as a mount source on its
    own: it must resolve lexically to `<root>/.bare/worktrees/<name>` for a
    `<root>` enclosing the workspace, no directory in that chain may be a symlink,
    and the metadata must point back at exactly this workspace. Relative and
    absolute pointers are both accepted, as Git writes either.
    """
    git = os.path.join(workspace, ".git")
    if os.path.isdir(git) and not os.path.islink(git):
        return None
    if not os.path.isfile(git) or os.path.islink(git):
        die(f"run from the repository root; no .git under {workspace}")
    pointer = read_git_line(git, "Git pointer")
    if not pointer.startswith("gitdir: "):
        die(f"malformed Git pointer: {git}")
    metadata = os.path.normpath(os.path.join(workspace, pointer.removeprefix("gitdir: ")))
    worktrees = os.path.dirname(metadata)
    common = os.path.dirname(worktrees)
    root = os.path.dirname(common)
    if (os.path.basename(worktrees) != "worktrees" or os.path.basename(common) != ".bare"
            or not workspace.startswith(root.rstrip(os.sep) + os.sep)
            or workspace == common or workspace.startswith(common + os.sep)):
        die(f"Git pointer does not name a worktree of an enclosing .bare: {pointer}")
    for directory in (common, worktrees, metadata):
        if os.path.islink(directory) or not os.path.isdir(directory):
            die(f"invalid Git metadata directory: {directory}")
    if read_git_line(os.path.join(metadata, "commondir"), "Git commondir") != "../..":
        die(f"unexpected Git commondir under {metadata}")
    backlink = read_git_line(os.path.join(metadata, "gitdir"), "Git backlink")
    if os.path.normpath(os.path.join(metadata, backlink)) != git:
        die(f"Git worktree metadata {metadata} belongs to another checkout: {backlink}")
    return LinkedGit(common, os.path.relpath(workspace, root), os.path.basename(metadata))


def worker_script(command: str | list[str], linked: LinkedGit | None = None) -> str:
    """Copy into scratch (including linked metadata) and preserve argv boundaries.

    Two modes, matching how the caller named the work:
      * list (from `-- cmd args...`): each element is quoted, so an argument with
        spaces, quotes, or metacharacters arrives as the caller's single argv
        entry. Joining with spaces instead would re-parse it and could execute
        something other than what was asked.
      * str (from `--check NAME`): the configured value is intended to be
        shell-parsed exactly once, in the worker, so it is wrapped in a subshell
        rather than quoted.
    """
    if isinstance(command, list):
        body = "exec " + " ".join(shlex.quote(part) for part in command)
    else:
        body = "( " + command + " )"
    if linked is not None:
        # Mirror the layout under scratch and rewrite both pointers in the *copy*,
        # so Git never follows a host path from scratch.
        checkout = f"{SCRATCH}/{linked.checkout}"
        metadata = f"{SCRATCH}/.bare/worktrees/{linked.name}"
        pointer = "gitdir: " + os.path.relpath(metadata, checkout)
        quote = shlex.quote
        prepare = (f"mkdir -p {quote(checkout)} {SCRATCH}/.bare && "
                   f"cp -a {SRC_TARGET}/. {quote(checkout + '/')} && "
                   f"cp -a {GIT_TARGET}/. {SCRATCH}/.bare/ && "
                   f"printf '%s\\n' {quote(pointer)} > {quote(checkout + '/.git')} && "
                   f"printf '%s\\n' {quote(checkout + '/.git')} > {quote(metadata + '/gitdir')} && "
                   f"cd {quote(checkout)}")
    else:
        prepare = f"mkdir -p {SCRATCH} && cp -a {SRC_TARGET}/. {SCRATCH}/ && cd {SCRATCH}"
    return f"{prepare} && {body}"


def build_argv(image: str, memory: str, cpus: str, network: str, workspace: str, script: str,
               git_common: str | None = None) -> list[str]:
    """The privileged part: what the worker can see. Kept pure so tests can pin it."""
    argv = [
        "podman",
        "create",
        "--name",
        "@VERIFY_NAME@",
        "--rm",
        "--pull=never",
        "--userns=keep-id",
        "--security-opt",
        "label=disable",
        "--network",
        network,
        "--memory",
        memory,
        "--cpus",
        cpus,
        "-v",
        f"{workspace}:{SRC_TARGET}:ro",
    ]
    if git_common is not None:
        argv += ["-v", f"{git_common}:{GIT_TARGET}:ro"]
    return argv + [
        "--entrypoint",
        "sh",
        image,
        "-c",
        script,
    ]


def env_for_worker() -> list[str]:
    """A minimal, explicit worker environment."""
    env = ["--env", "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
           "--env", "HOME=" + SCRATCH, "--env", "TMPDIR=/tmp",
           # Never inherit the agent container's git identity or config path.
           "--env", "GIT_CONFIG_GLOBAL=/dev/null", "--env", "GIT_TERMINAL_PROMPT=0"]
    for name in PASSTHROUGH_ENV:
        if name in os.environ:
            env += ["--env", f"{name}={os.environ[name]}"]
    return env


def run_podman(argv: list[str], timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    # check=False is deliberate: a non-zero exit is the *result* of a verification
    # run and has to be reported, not raised.
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def acquire_lock() -> Any:
    """Serialize worker creation. Held only across `podman create`."""
    lock_dir = os.environ.get("OPENCODE_VERIFY_LOCK_DIR", os.path.join(tempfile.gettempdir(), "opencode-verify"))
    try:
        os.makedirs(lock_dir, exist_ok=True)
        # Not a context manager on purpose: the open descriptor *is* the lock, so
        # it must outlive this function. main() unlocks and closes it in a finally.
        handle = open(os.path.join(lock_dir, "create.lock"), "w")  # noqa: SIM115
    except OSError as error:
        die(f"cannot create lock under {lock_dir}: {error}", START_FAILED)
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def start_worker(argv: list[str], container: str) -> str:
    created = run_podman(argv)
    if created.returncode != 0:
        detail = (created.stderr or created.stdout).strip()
        die(f"worker creation failed: {detail[-400:]}", START_FAILED)
    return container


def main() -> None:
    parser = argparse.ArgumentParser(prog="oc2-verify", description=__doc__.splitlines()[0])
    parser.add_argument("--check", help="a named command from the sandbox config's verify.checks")
    parser.add_argument("--json", action="store_true", help="emit a machine-readable result object")
    parser.add_argument("--list", action="store_true", help="list configured checks and exit")
    parser.add_argument("--image", help="override the worker image (must already exist locally)")
    parser.add_argument("--timeout", type=int, help="wall-clock limit in seconds")
    parser.add_argument("dash_command", nargs=argparse.REMAINDER, help="command to run, after --")
    args = parser.parse_args()

    config = load_verify_config()
    checks = config.get("checks", {})
    if args.list:
        if not checks:
            print("no checks configured (verify.checks in the sandbox config)")
            return
        for name in sorted(checks):
            print(f"{name}\t{checks[name]}")
        return

    command = resolve_command(args, checks)
    image = args.image or config.get("image") or DEFAULT_IMAGE
    timeout = args.timeout or config.get("timeout_seconds") or DEFAULT_TIMEOUT_SECONDS
    memory = config.get("memory") or DEFAULT_MEMORY
    cpus = config.get("cpus") or DEFAULT_CPUS
    network = config.get("network", "none")
    cap = config.get("output_cap_bytes") or DEFAULT_OUTPUT_CAP_BYTES

    workspace = os.path.realpath(os.getcwd())
    linked = workspace_git_common(workspace)

    # Refuse rather than start a worker the caller cannot trust: an image that is
    # not already local would be pulled at run time by an unreviewed reference.
    exists = run_podman(["podman", "image", "exists", image])
    if exists.returncode != 0:
        die(f"worker image {image} is not available locally (pull=never)", START_FAILED)

    argv = build_argv(image, memory, cpus, network, workspace,
                      worker_script(command, linked), linked.common if linked else None)
    argv[4:4] = env_for_worker()

    lock = acquire_lock()
    try:
        container = "oc2-verify-" + str(os.getpid()) + "-" + str(int(time.time()))
        argv[argv.index("@VERIFY_NAME@")] = container
        start_worker(argv, container)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()

    started = time.monotonic()
    status, output = "ok", ""
    try:
        attached = run_podman(["podman", "start", "--attach", container], timeout=float(timeout))
        exit_code = attached.returncode
        output = attached.stdout + (("\n[stderr]\n" + attached.stderr) if attached.stderr else "")
    except subprocess.TimeoutExpired as error:
        status, exit_code = "timeout", TIMEOUT_EXIT
        partial = error.stdout or b""
        output = (partial.decode("utf-8", "replace") if isinstance(partial, bytes) else str(partial))
    finally:
        run_podman(["podman", "rm", "--force", container], timeout=60.0)

    truncated = len(output) > cap
    if truncated:
        output = output[:cap]
    duration = round(time.monotonic() - started, 2)

    if args.json:
        print(json.dumps({
            "status": status, "exit_code": exit_code, "duration_seconds": duration,
            "image": image, "network": network, "command": describe_command(command),
            "output_truncated": truncated, "output": output,
        }, indent=2))
    else:
        sys.stdout.write(output)
        if truncated:
            print(f"\n[oc2-verify: output truncated at {cap} bytes]", file=sys.stderr)
        print(f"[oc2-verify] {status} exit={exit_code} {duration}s image={image}", file=sys.stderr)

    raise SystemExit(exit_code)


if __name__ == "__main__":
    main()
