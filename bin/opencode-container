#!/usr/bin/env python3
"""opencode-container — run the OpenCode2 container for this workspace.

Pure Python 3 standard library; no third-party dependencies.

Uses $PWD/.opencode-sandbox.json (schema_version 1) when present, otherwise
warns and runs the baked image defaults against the current workspace. A
sandbox config is trusted repository input: it controls local image builds and
container run settings, so review it like executable project tooling. Secret
values are never echoed.

Usage:
    opencode-container                    build if needed, run the default command
    opencode-container run [CMD...]       run a command in the container (default action)
    opencode-container shell              drop into bash instead
    opencode-container build [--force]    build the image without running a container
    opencode-container secrets add NAME [--in FILE|-]
                                          create a provider secret and opt the
                                          workspace's .opencode-sandbox.json into it
    opencode-container secrets remove NAME
                                          remove the provider secret and its opt-in

run, shell, and build accept --image FQN: a fully qualified name without a tag
(registry:port/name is fine). The build context must be a git repository with
at least one commit; the image is tagged <FQN>:<git-sha8> and <FQN>:latest,
and the hash-pinned reference is what gets built or run. build --force rebuilds
even when the image already exists.

The secrets subcommand manages the Podman provider secrets the launcher can
inject. "secrets add" creates the secret and lists NAME in the current
workspace's .opencode-sandbox.json provider_secrets array (creating the file
when absent); "secrets remove" deletes the secret and drops the entry. Only
known provider secret names are accepted. The value is taken from --in FILE,
stdin (--in -), or a password-style prompt, and never appears in the process
argument list.

Requirements: python3 (3.10+), podman, git, id.
"""

import argparse
import atexit
import getpass
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import textwrap
from collections.abc import Iterator, Sequence
from typing import Any, Final, Literal, NoReturn

if sys.version_info < (3, 10):
    print(
        "opencode-container: python3 (3.10+) is required "
        f"(found {sys.version_info[0]}.{sys.version_info[1]})",
        file=sys.stderr,
    )
    sys.exit(1)

PROG: Final[str] = "opencode-container"

DEFAULT_IMAGE: Final[str] = "opencode2:latest"
DEFAULT_COMMAND: Final[tuple[str, ...]] = ("opencode2", "--standalone")

# Baked config/plugin paths and launcher control mounts; additional mounts may
# not shadow these, including through lexical `..` path segments.
BAKED_ROOTS: Final[tuple[str, ...]] = (
    "/etc/opencode",
    "/opt/opencode",
    "/opt/mcp",
    "/run/opencode",
    "/src",
    "/workspace",
)
# containers mode does not create the generated /workspace/<hash> mount, so a
# host workspace that genuinely lives below /workspace can be mirrored safely.
CONTAINERS_WORKSPACE_RESERVED_ROOTS: Final[tuple[str, ...]] = (
    "/etc/opencode",
    "/opt/opencode",
    "/opt/mcp",
    "/run/opencode",
    "/run/opencode-container-engine.sock",
    "/src",
)

GLOBAL_GIT_CONFIG_TARGET: Final[str] = "/run/opencode/gitconfig"
ROUTER_GLOBAL_TARGET: Final[str] = "/run/opencode/model-router-global.json"
SANDBOX_TARGET: Final[str] = "/run/opencode/sandbox.json"
CONTAINER_SOCKET_TARGET: Final[str] = "/run/opencode-container-engine.sock"
LOCAL_PROVIDERS_TARGET: Final[str] = "/opt/opencode/config/opencode/opencode.json"
LOCAL_PROVIDERS_LABEL: Final[str] = "io.opencode.local-providers-sha256"
OPENCODE_DATA_MOUNT: Final[str] = "/var/lib/opencode-data"

# Provider API keys auto-forwarded when set in the host environment. This is
# the common multi-provider list plus AZURE_OPENAI_API_KEY. Unset variables are
# skipped; nothing is synthesized.
PROVIDER_ENV_VARS: Final[tuple[str, ...]] = (
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "DEEPSEEK_API_KEY",
    "GROQ_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "MISTRAL_API_KEY",
    "XAI_API_KEY",
    "OPENROUTER_API_KEY",
    "PERPLEXITY_API_KEY",
    "COHERE_API_KEY",
    "TOGETHER_API_KEY",
    "AZURE_OPENAI_API_KEY",
)

# Podman secret names mapped to the provider environment variables OpenCode2
# expects. Projects explicitly select names; openapi-api-key is retained as a
# compatibility alias for the canonical openai-api-key spelling.
PROVIDER_SECRET_SPECS: Final[tuple[tuple[str, str, str | None], ...]] = (
    ("OPENAI_API_KEY", "openai-api-key", "openapi-api-key"),
    ("ANTHROPIC_API_KEY", "anthropic-api-key", None),
    ("DEEPSEEK_API_KEY", "deepseek-api-key", None),
    ("GROQ_API_KEY", "groq-api-key", None),
    ("GOOGLE_API_KEY", "google-api-key", None),
    ("GEMINI_API_KEY", "gemini-api-key", None),
    ("GOOGLE_GENERATIVE_AI_API_KEY", "google-generative-ai-api-key", None),
    ("MISTRAL_API_KEY", "mistral-api-key", None),
    ("XAI_API_KEY", "xai-api-key", None),
    ("OPENROUTER_API_KEY", "openrouter-api-key", None),
    ("PERPLEXITY_API_KEY", "perplexity-api-key", None),
    ("COHERE_API_KEY", "cohere-api-key", None),
    ("TOGETHER_API_KEY", "together-api-key", None),
    ("AZURE_OPENAI_API_KEY", "azure-openai-api-key", None),
)

ENV_NAME_RE: Final[re.Pattern[str]] = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
VOLUME_NAME_RE: Final[re.Pattern[str]] = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*\Z")
CREDENTIAL_KEY_RE: Final[re.Pattern[str]] = re.compile(
    r"^(api[-_]?key|authorization|headers|token|access[-_]?token|secret"
    r"|client[-_]?secret|password|credential|credentials)$",
    re.IGNORECASE,
)
ALLOWED_RUNTIME_ARG_PREFIXES: Final[tuple[str, ...]] = (
    "--add-host=",
    "--pids-limit=",
    "--ulimit=",
)

# How an environment variable reaches the container: "pass" forwards the
# process value by name (secrets stay out of argv), "set" carries a literal.
EnvMode = Literal["pass", "set"]

TEMP_FILES: list[str] = []
PODMAN_PATH: str | None = None


# --- Guardrails --------------------------------------------------------------
def die(message: str) -> NoReturn:
    print(f"{PROG}: {message}", file=sys.stderr)
    sys.exit(1)


def warn(message: str) -> None:
    print(f"{PROG}: warning: {message}", file=sys.stderr)


def cleanup_temp_files() -> None:
    for path in TEMP_FILES:
        try:
            os.unlink(path)
        except OSError:
            pass
    TEMP_FILES.clear()


atexit.register(cleanup_temp_files)


def ensure_requirements() -> None:
    global PODMAN_PATH
    for tool in ("git", "id"):
        if shutil.which(tool) is None:
            die(f"{tool} is required (install it and retry)")
    podman = shutil.which("podman")
    if podman is None:
        die("podman is required (install it and retry)")
    PODMAN_PATH = podman


def podman_executable() -> str:
    """The podman executable resolved by ensure_requirements()."""
    if PODMAN_PATH is None:
        die("podman is required (install it and retry)")
    return PODMAN_PATH


# --- Small helpers ------------------------------------------------------------
def jq_or(value: Any, default: Any) -> Any:
    """jq's `//` operator: fall back when the value is null or false."""
    if value is None or value is False:
        return default
    return value


def jq_string(value: Any) -> str:
    """How `jq -r` renders a scalar (for legacy string comparisons)."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return value
    return json.dumps(value)


def parse_single_json_object(raw: bytes, label: str, path: str) -> dict[str, Any]:
    """Parse one JSON object document, rejecting duplicate object keys."""
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        die(f"invalid {label}: {path}")

    def object_without_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate object key")
            result[key] = value
        return result

    body = text.lstrip()
    try:
        value, end = json.JSONDecoder(
            object_pairs_hook=object_without_duplicates
        ).raw_decode(body)
    except ValueError:
        die(f"invalid {label}: {path}")
    if body[end:].strip():
        die(f"invalid {label}: {path}")
    if not isinstance(value, dict):
        die(f"invalid {label}: {path}")
    return value


def paths_overlap(path: str, *roots: str) -> bool:
    """True if either side equals or contains the other."""
    for root in roots:
        # Root necessarily overlaps every absolute protected path.
        if path == "/" or root == "/":
            return True
        if path == root or path.startswith(root + "/") or root.startswith(path + "/"):
            return True
    return False


def id_output(flag: str) -> str:
    """Run `id <flag>` via PATH; return stdout stripped.

    Invoked via PATH (like the shell launcher) so the host's own tooling
    identifies the user, not this interpreter.
    """
    try:
        proc = subprocess.run(
            ["id", flag],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            errors="replace",
            check=False,
        )
    except OSError:
        die("id is required (used to identify the host user)")
    if proc.returncode != 0:
        die(f"unable to run id {flag}")
    return proc.stdout.strip()


def git_output(cwd: str, *args: str) -> str | None:
    """Run `git -C <cwd> <args>`; return stdout, or None on failure."""
    proc = subprocess.run(
        ["git", "-C", cwd, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
        check=False,
    )
    if proc.returncode != 0:
        return None
    return proc.stdout


def podman_quiet(*args: str) -> bool:
    """Run `podman <args>` with output suppressed; return True on success."""
    proc = subprocess.run(
        [podman_executable(), *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return proc.returncode == 0


def podman_image_label(image: str, label: str) -> str | None:
    """Return one image label, or None when the image has no readable value."""
    proc = subprocess.run(
        [
            podman_executable(),
            "image",
            "inspect",
            "--format",
            "{{index .Labels \"" + label + "\"}}",
            image,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
        check=False,
    )
    if proc.returncode != 0:
        return None
    value = proc.stdout.rstrip("\n")
    return value or None


def xdg_path(name: str, default: str) -> str:
    """The effective XDG directory: a set (non-empty) value, else the default."""
    return os.environ.get(name) or default


def is_reserved_env_name(name: str) -> bool:
    return (
        name in ("HOME", "PATH", "GIT_CONFIG_GLOBAL")
        or name.startswith(("XDG_", "OPENCODE_"))
    )


# --- Host discovery -----------------------------------------------------------
def find_global_router(config_home: str) -> str | None:
    path = config_home + "/opencode2/model-router.json"
    if not os.path.lexists(path):
        return None
    if not os.path.isfile(path):
        die(f"global model-router config is not a regular file: {path}")
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        die(f"unable to read global model-router config: {path}")
    parse_single_json_object(raw, "global model-router config", path)
    return os.path.realpath(path)


def find_global_git_config(home: str) -> str | None:
    # Git's user-global config follows host HOME, independently of the workspace
    # and the XDG paths used by OpenCode. Mount only the canonical file and point
    # Git at a stable launcher-owned target so this also works with prebuilt
    # images whose baked username differs from the host username.
    path = home + "/.gitconfig"
    if not os.path.lexists(path):
        return None
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        die(f"user-global Git config is not a readable regular file: {path}")
    return os.path.realpath(path)


def host_state_roots(
    config_home: str, data_home: str, state_home: str, cache_home: str, home: str
) -> list[str]:
    """Canonical host agent-state roots the container must never reach by mount.

    The launcher deliberately does not forward OpenCode, .agents, .claude, or
    .mcp state. Canonicalize so a symlinked host-state directory cannot be
    exposed by mounting its resolved target.
    """
    candidates = (
        config_home + "/opencode",
        data_home + "/opencode",
        state_home + "/opencode",
        cache_home + "/opencode",
        home + "/.agents",
        home + "/.claude",
        home + "/.mcp",
    )
    return [os.path.realpath(candidate) for candidate in candidates]


def discover_container_socket(uid: str) -> str | None:
    """First accessible container-engine socket, canonicalized.

    Prefers the user Podman socket over a rootless or system Docker socket;
    checks the node and host-user permissions, not API liveness.
    """
    candidates: list[str] = []
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if xdg_runtime.startswith("/"):
        candidates.append(xdg_runtime + "/podman/podman.sock")
    candidates.append("/run/user/" + uid + "/podman/podman.sock")
    if xdg_runtime.startswith("/"):
        candidates.append(xdg_runtime + "/docker.sock")
    candidates.append("/run/user/" + uid + "/docker.sock")
    candidates.append("/var/run/docker.sock")
    candidates.append("/run/docker.sock")

    seen: set[str] = set()
    for candidate in candidates:
        try:
            st = os.stat(candidate)
        except OSError:
            continue
        if not stat.S_ISSOCK(st.st_mode):
            continue
        if not os.access(candidate, os.R_OK | os.W_OK):
            continue
        canonical = os.path.realpath(candidate)
        if canonical in seen:
            continue
        seen.add(canonical)
        return canonical
    return None


# --- Local provider catalog validation ----------------------------------------
def _nonempty_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value)


def _positive_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0


def iter_object_keys(node: Any) -> Iterator[str]:
    """Every object key in the document, at every nesting level."""
    if isinstance(node, dict):
        for key, value in node.items():
            yield key
            yield from iter_object_keys(value)
    elif isinstance(node, list):
        for item in node:
            yield from iter_object_keys(item)


def local_providers_valid(catalog: dict[str, Any]) -> bool:
    """Validate the constrained provider-only catalog shape."""
    if set(catalog) - {"$schema", "provider"}:
        return False
    provider = catalog.get("provider")
    if not isinstance(provider, dict) or not provider:
        return False
    for name, spec in provider.items():
        if not name or not isinstance(spec, dict):
            return False
        if spec.get("npm") != "@ai-sdk/openai-compatible":
            return False
        if "name" in spec and not _nonempty_string(spec["name"]):
            return False
        options = spec.get("options")
        if not isinstance(options, dict):
            return False
        base_url = options.get("baseURL")
        if not isinstance(base_url, str) or not base_url:
            return False
        models = spec.get("models")
        if not isinstance(models, dict) or not models:
            return False
        for model_name, model in models.items():
            if not model_name or not isinstance(model, dict):
                return False
            if "name" in model and not _nonempty_string(model["name"]):
                return False
            if "limit" in model:
                limit = model["limit"]
                if not isinstance(limit, dict):
                    return False
                for key in ("context", "output"):
                    if key in limit and not _positive_number(limit[key]):
                        return False
    # Obvious credential field names are rejected anywhere in the document.
    return not any(CREDENTIAL_KEY_RE.match(key) for key in iter_object_keys(catalog))


def find_local_providers(config_home: str) -> tuple[str, str] | None:
    """Validate and return the catalog's canonical path and content digest."""
    path = config_home + "/opencode2/local-providers.json"
    if not os.path.lexists(path):
        return None
    if not os.path.isfile(path):
        die(f"local provider catalog is not a regular file: {path}")
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        die(f"unable to read local provider catalog: {path}")
    catalog = parse_single_json_object(raw, "local provider catalog", path)
    if not local_providers_valid(catalog):
        die(f"invalid local provider catalog: {path}")
    return os.path.realpath(path), hashlib.sha256(raw).hexdigest()


# --- CLI -----------------------------------------------------------------------
IMAGE_HELP: Final[str] = (
    "fully qualified image name (no tag) to build from the configured "
    "build block; tagged <FQN>:<git-sha8> and <FQN>:latest, and the "
    "hash-pinned reference is built and run"
)


def _add_image_flag(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--image", metavar="FQN", help=IMAGE_HELP)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Run the OpenCode2 sandbox container for this workspace.",
        epilog=textwrap.dedent(
            """\
            commands:
              With no command, "run" is the default action: the configured
              command (or the default "opencode2 --standalone") runs.

                opencode-container                    build if needed, run the default command
                opencode-container run [CMD...]       run CMD in the container
                opencode-container shell              drop into bash instead
                opencode-container build [--force]    build the image, do not run
                opencode-container secrets add NAME   create a provider secret and opt in
                opencode-container secrets remove NAME
                                                      remove the secret and its opt-in

              Arguments after "run" are passed to the container verbatim:
              "opencode-container run ls -la". A "--" directly before the
              command is treated as the option separator and dropped.

              secrets manages the Podman provider secrets this launcher
              injects. Only known provider secret names are accepted. The
              value comes from --in FILE, from stdin with --in -, or, by
              default, from a password-style prompt that is not echoed. It is
              never passed on the command line.

            The launcher runs from any directory on PATH: project behavior is
            derived from the invocation directory, which supplies the workspace,
            the CWD-derived workdir and data volume, and
            $PWD/.opencode-sandbox.json (schema_version 1) when present. Without
            that config it warns and uses the baked defaults: image
            opencode2:latest, the current directory as the workspace, and
            "opencode2 --standalone".
            """
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Every namespace carries the same keys regardless of the sub-command.
    parser.set_defaults(
        image=None,
        force=False,
        command_args=None,
        action=None,
        name=None,
        input=None,
    )
    sub = parser.add_subparsers(dest="subcommand", metavar="COMMAND")

    run_parser = sub.add_parser(
        "run",
        help="build if needed, then run the container (the default action)",
    )
    _add_image_flag(run_parser)
    run_parser.add_argument(
        "command_args",
        nargs=argparse.REMAINDER,
        metavar="CMD",
        help=(
            "command to run in the container, passed through verbatim; "
            "defaults to the configured command or opencode2 --standalone"
        ),
    )

    shell_parser = sub.add_parser(
        "shell",
        help="build if needed, then drop into bash instead",
    )
    _add_image_flag(shell_parser)

    build_parser = sub.add_parser(
        "build",
        help="build the image without running a container",
    )
    _add_image_flag(build_parser)
    build_parser.add_argument(
        "--force",
        action="store_true",
        help="build even if the image already exists",
    )

    secrets_parser = sub.add_parser(
        "secrets",
        help="manage the Podman provider secrets the launcher injects",
        description=(
            "Manage the Podman provider secrets this launcher injects. "
            "'add' creates the secret and lists it in the current workspace's "
            ".opencode-sandbox.json provider_secrets (creating the file when "
            "absent); 'remove' deletes the secret and drops the entry."
        ),
        epilog=textwrap.dedent(
            f"""\
            The value is never echoed and never appears in the process argument
            list. With no --in, it is prompted for like a password (a terminal
            is required); --in FILE reads it from a file and --in - reads it
            from stdin. A single trailing newline is dropped.

            Valid names: {", ".join(primary for _env, primary, _alt in PROVIDER_SECRET_SPECS)}
            (openapi-api-key is accepted as an alias for openai-api-key)
            """
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    secrets_sub = secrets_parser.add_subparsers(
        dest="action", required=True, metavar="add|remove"
    )
    add_parser = secrets_sub.add_parser(
        "add",
        help="create the Podman secret and add it to provider_secrets",
    )
    add_parser.add_argument("name", help="known provider secret name")
    add_parser.add_argument(
        "--in",
        dest="input",
        metavar="FILE",
        help=(
            "read the secret value from FILE, or from stdin with - "
            "(default: prompt without echoing)"
        ),
    )
    remove_parser = secrets_sub.add_parser(
        "remove",
        help="remove the Podman secret and its provider_secrets entry",
    )
    remove_parser.add_argument("name", help="known provider secret name")
    return parser


# --- Provider secrets ------------------------------------------------------------
def canonical_secret_name(name: str) -> str:
    """Resolve a requested secret name to its canonical provider secret name."""
    for _env_target, primary, alternate in PROVIDER_SECRET_SPECS:
        if name in (primary, alternate):
            return primary
    valid = ", ".join(primary for _env, primary, _alternate in PROVIDER_SECRET_SPECS)
    die(f"unknown provider secret name: {name} (valid names: {valid})")


def sandbox_config_path() -> str:
    # Secrets are workspace-scoped, like every other launcher behavior: the
    # current workspace's sandbox config is the one edited.
    return os.getcwd() + "/.opencode-sandbox.json"


def load_sandbox_config(path: str) -> tuple[dict[str, Any], bool]:
    """Parse the workspace sandbox config; return (config, present)."""
    if not os.path.lexists(path):
        return {}, False
    if not os.path.isfile(path):
        die(f"sandbox config is not a regular file: {path}")
    try:
        with open(path, "rb") as handle:
            raw = handle.read()
    except OSError:
        die(f"unable to read sandbox config: {path}")
    try:
        config: Any = json.loads(raw)
    except ValueError as exc:  # JSONDecodeError or UnicodeDecodeError
        die(f"invalid sandbox config {path}: {exc}")
    if not isinstance(config, dict):
        die(f"sandbox config must be a JSON object: {path}")
    return config, True


def write_sandbox_config(path: str, config: dict[str, Any]) -> None:
    """Atomically rewrite the workspace sandbox config, preserving its mode."""
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        mode = 0o644
    try:
        fd, tmp_path = tempfile.mkstemp(
            prefix=".opencode-sandbox.json.", dir=os.path.dirname(path)
        )
    except OSError:
        die(f"unable to write sandbox config: {path}")
    TEMP_FILES.append(tmp_path)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(config, indent=2, ensure_ascii=False) + "\n")
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    except OSError:
        die(f"unable to write sandbox config: {path}")
    finally:
        if os.path.lexists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
    TEMP_FILES.remove(tmp_path)


def config_upsert_provider_secret(config: dict[str, Any], name: str) -> bool:
    """Append name to provider_secrets (creating the key); report a change."""
    entry = config.get("provider_secrets")
    if entry is None or entry is False:
        entry = []
        config["provider_secrets"] = entry
    if not isinstance(entry, list):
        die("provider_secrets must be an array in .opencode-sandbox.json")
    if name not in entry:
        entry.append(name)
        return True
    return False


def config_remove_provider_secret(config: dict[str, Any], name: str) -> bool:
    """Drop name from provider_secrets; drop an emptied key; report a change."""
    entry = config.get("provider_secrets")
    if entry is None or entry is False:
        return False
    if not isinstance(entry, list):
        die("provider_secrets must be an array in .opencode-sandbox.json")
    if name not in entry:
        return False
    entry.remove(name)
    if not entry:
        del config["provider_secrets"]
    return True


def read_secret_value(name: str, input_spec: str | None) -> str:
    """Read the secret value from --in, or prompt for it without echoing."""
    if input_spec is None:
        if not sys.stdin.isatty():
            die(
                "no terminal is available for the interactive secret prompt; "
                "pass the value with --in FILE or pipe it with --in -"
            )
        try:
            value = getpass.getpass(f"Secret value for {name}: ")
        except EOFError:
            die("secret input was cancelled")
        except getpass.GetPassWarning as exc:
            die(f"unable to prompt for the secret: {exc}")
        raw = value.encode("utf-8")
    elif input_spec == "-":
        if sys.stdin.isatty():
            die(
                "--in - reads the value from stdin, but stdin is a terminal; "
                "pass a file or omit --in to type the value"
            )
        raw = sys.stdin.buffer.read()
    else:
        if not os.path.isabs(input_spec):
            input_spec = os.getcwd() + "/" + input_spec
        if not os.path.isfile(input_spec):
            die(f"--in path is not a regular file: {input_spec}")
        try:
            with open(input_spec, "rb") as handle:
                raw = handle.read()
        except OSError:
            die(f"unable to read --in file: {input_spec}")
    try:
        value = raw.decode("utf-8")
    except UnicodeDecodeError:
        die("the secret value must be valid UTF-8")
    # A single trailing newline (from echo, a shell, or an editor) is not part
    # of a key; any other byte is preserved verbatim.
    value = value.removesuffix("\r\n").removesuffix("\n")
    if not value:
        die(f"the secret value for {name} must not be empty")
    return value


def podman_secret_create(name: str, value: str) -> None:
    # The value goes over stdin so it never appears in a process argument list.
    proc = subprocess.run(
        [podman_executable(), "secret", "create", name, "-"],
        input=value.encode("utf-8"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", "replace").strip()
        die(f"podman secret create failed: {detail or name}")


def podman_secret_remove(name: str) -> None:
    proc = subprocess.run(
        [podman_executable(), "secret", "rm", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", "replace").strip()
        die(f"podman secret rm failed: {detail or name}")


def secret_add(name: str, input_spec: str | None) -> NoReturn:
    # Fail before prompting when the name is taken, so a re-entry attempt does
    # not ask for a value that would be rejected.
    if podman_quiet("secret", "exists", name):
        die(
            f"Podman secret {name} already exists; run "
            f"'{PROG} secrets remove {name}' first to replace it"
        )
    value = read_secret_value(name, input_spec)
    # The workspace opt-in is written before the secret is created, so a
    # failed create leaves a config that names a missing secret (the launcher
    # reports that clearly) and a plain re-run of secrets add retries cleanly.
    config_path = sandbox_config_path()
    config, present = load_sandbox_config(config_path)
    if not present:
        config = {"schema_version": 1}
    hooked = config_upsert_provider_secret(config, name)
    if hooked:
        write_sandbox_config(config_path, config)
    podman_secret_create(name, value)
    print(f"{PROG}: created Podman secret {name}")
    if hooked:
        print(f"{PROG}: added {name} to provider_secrets in {config_path}")
    else:
        print(f"{PROG}: {name} was already listed in provider_secrets")
    sys.exit(0)


def secret_remove(name: str) -> NoReturn:
    existed = podman_quiet("secret", "exists", name)
    # Drop the workspace opt-in first: if the podman removal then fails, the
    # secret is simply not injected, and re-running secrets remove finishes it.
    config_path = sandbox_config_path()
    config, _present = load_sandbox_config(config_path)
    unhooked = config_remove_provider_secret(config, name)
    if unhooked:
        write_sandbox_config(config_path, config)
    if existed:
        podman_secret_remove(name)
    if not existed and not unhooked:
        print(f"{PROG}: nothing to remove for {name} (no Podman secret, no provider_secrets entry)")
    else:
        if unhooked:
            print(f"{PROG}: removed {name} from provider_secrets in {config_path}")
        if existed:
            print(f"{PROG}: removed Podman secret {name}")
    sys.exit(0)


def handle_secrets(args: argparse.Namespace) -> NoReturn:
    name = canonical_secret_name(args.name)
    if args.action == "add":
        secret_add(name, args.input)
    else:
        secret_remove(name)


# --- Main ------------------------------------------------------------------------
def main(argv: Sequence[str] | None = None) -> NoReturn:
    args: argparse.Namespace = build_parser().parse_args(
        sys.argv[1:] if argv is None else argv
    )

    ensure_requirements()

    # The secrets subcommand is host-side only: it never builds or runs a
    # container, and needs none of the workspace run configuration.
    if args.subcommand == "secrets":
        handle_secrets(args)

    try:
        invocation_root = os.path.realpath(os.getcwd())
    except OSError:
        die("unable to resolve the current working directory")

    home = os.environ.get("HOME", "")
    config_home = xdg_path("XDG_CONFIG_HOME", home + "/.config")
    data_home = xdg_path("XDG_DATA_HOME", home + "/.local/share")
    state_home = xdg_path("XDG_STATE_HOME", home + "/.local/state")
    cache_home = xdg_path("XDG_CACHE_HOME", home + "/.cache")

    global_router = find_global_router(config_home)
    global_git_config = find_global_git_config(home)
    local_providers = find_local_providers(config_home)
    host_state = host_state_roots(config_home, data_home, state_home, cache_home, home)

    # --- Config loading + validation ------------------------------------------
    config_path = invocation_root + "/.opencode-sandbox.json"
    config_present = os.path.lexists(config_path)
    if config_present and not os.path.isfile(config_path):
        die(f"sandbox config is not a regular file: {config_path}")
    if config_present:
        try:
            with open(config_path, "rb") as handle:
                raw = handle.read()
        except OSError:
            die(f"unable to read sandbox config: {config_path}")
        try:
            config: dict[str, Any] = json.loads(raw)
        except ValueError as exc:  # JSONDecodeError or UnicodeDecodeError
            die(f"invalid sandbox config {config_path}: {exc}")
        if not isinstance(config, dict):
            die(f"sandbox config must be a JSON object: {config_path}")
    else:
        config = {}
        if global_router is not None:
            warn(
                f"no .opencode-sandbox.json found; using image {DEFAULT_IMAGE}, "
                f"workspace {invocation_root}, and user-global routing config"
            )
        else:
            warn(
                f"no .opencode-sandbox.json found; using image {DEFAULT_IMAGE}, "
                f"workspace {invocation_root}, and baked routing defaults"
            )

    schema_version = jq_or(config.get("schema_version"), 1)
    if jq_string(schema_version) != "1":
        die(f"unsupported schema_version: {jq_string(schema_version)}")

    containers_enabled = False
    if "containers" in config:
        containers = config["containers"]
        if not isinstance(containers, bool):
            die("containers must be a boolean")
        containers_enabled = containers

    image = jq_or(config.get("image"), DEFAULT_IMAGE)
    if not isinstance(image, str):
        die("image must be a string")

    # Optional build block.
    build_config = config.get("build")
    if build_config is None or build_config is False:
        has_build_config = False
        build_config = {}
    else:
        if not isinstance(build_config, dict):
            die("build must be an object")
        has_build_config = True
    containerfile = jq_or(build_config.get("containerfile"), "Containerfile")
    if not isinstance(containerfile, str):
        die("build.containerfile must be a string")
    context = jq_or(build_config.get("context"), "")
    if not isinstance(context, str):
        die("build.context must be a string")
    if context == "":
        context = os.path.dirname(containerfile) or "."
    # Resolve build paths against the workspace (CWD).
    if not containerfile.startswith("/"):
        containerfile = invocation_root + "/" + containerfile
    if not context.startswith("/"):
        context = invocation_root + "/" + context

    # Workspace is mounted at /src for compatibility and normally at a stable,
    # CWD-derived path for OpenCode2's project/session identity. containers mode
    # uses the canonical host path instead so nested bind mounts remain meaningful.
    workspace = jq_or(config.get("workspace"), "")
    if not isinstance(workspace, str):
        die("workspace must be a string")
    if workspace == "":
        workspace = invocation_root
    if not workspace.startswith("/"):
        workspace = invocation_root + "/" + workspace
    # realpath -e semantics: a missing workspace fails closed.
    if not os.path.exists(workspace):
        die(f"workspace does not exist: {workspace}")
    workspace = os.path.realpath(workspace)
    if paths_overlap(workspace, *host_state):
        die(f"workspace {workspace} overlaps host OpenCode/.agents/.claude/.mcp state")
    if global_router is not None and paths_overlap(workspace, global_router):
        die(f"workspace {workspace} overlaps the user-global model-router config")
    if global_git_config is not None and paths_overlap(workspace, global_git_config):
        die(f"workspace {workspace} overlaps the user-global Git config")
    if local_providers is not None and paths_overlap(workspace, local_providers[0]):
        die(f"workspace {workspace} overlaps the local provider catalog")

    # The CWD-derived project identity stays stable even when the launcher
    # itself lives elsewhere on PATH.
    project_key = hashlib.sha256(invocation_root.encode("utf-8")).hexdigest()[:16]
    if containers_enabled:
        # Bind paths sent through a mounted host container-engine socket are
        # resolved by the host daemon. Mirror the workspace's canonical host
        # path so $PWD-based nested mounts name a path that exists on that host.
        if paths_overlap(workspace, *CONTAINERS_WORKSPACE_RESERVED_ROOTS):
            die(f"containers workspace target {workspace} shadows a baked config/plugin path")
        container_workspace = workspace
    else:
        container_workspace = "/workspace/" + project_key

    workdir = jq_or(config.get("workdir"), "")
    if not isinstance(workdir, str):
        die("workdir must be a string")
    if workdir == "" or workdir == "/src":
        workdir = container_workspace
    elif workdir.startswith("/src/"):
        workdir = container_workspace + "/" + workdir.removeprefix("/src/")
    elif workdir.startswith("/"):
        pass  # other absolute workdirs are used as-is
    else:
        workdir = container_workspace + "/" + workdir
    if containers_enabled:
        workdir = os.path.realpath(workdir)
        if workdir != container_workspace and not workdir.startswith(container_workspace + "/"):
            die(f"containers workdir {workdir} must stay within workspace {container_workspace}")

    # --- Build ------------------------------------------------------------------
    # Runs before run-flag assembly so `build` never depends on container run
    # state (engine socket, mounts, environment, worktree metadata).
    image_tags: list[str] = [image]
    if args.image:
        # --image selects a fully qualified name (no tag) to build from this
        # repository. The image is tagged both with the first 8 characters of
        # the build context's HEAD commit and with latest, and the hash-pinned
        # reference is what gets built and run.
        if any(ch.isspace() for ch in args.image):
            die(f"--image contains whitespace: {args.image}")
        if ":" in args.image.rsplit("/", 1)[-1]:
            die(
                f"--image must be a fully qualified name without a tag "
                f"(got {args.image}); the launcher tags <name>:<git-sha> and <name>:latest"
            )
        git_sha = git_output(context, "rev-parse", "--verify", "HEAD")
        if git_sha is None:
            die(
                f"--image requires the build context to be a git repository with at "
                f"least one commit: {context}"
            )
        git_sha = git_sha.strip()[:8]
        image = args.image + ":" + git_sha
        image_tags = [image, args.image + ":latest"]

    image_exists = podman_quiet("image", "exists", image)
    local_providers_sha = "absent" if local_providers is None else local_providers[1]
    if image_exists and has_build_config and local_providers is not None:
        # The catalog is runtime-mounted, but its digest is still recorded on
        # launcher-built images. A changed catalog therefore triggers exactly
        # one rebuild without making its bytes part of the image. Removing the
        # file needs no rebuild because it simply removes the runtime mount.
        if podman_image_label(image, LOCAL_PROVIDERS_LABEL) != local_providers_sha:
            image_exists = False

    if args.force or not image_exists:
        if not has_build_config:
            if image_exists:
                die(f"no build block is configured to rebuild image {image}")
            die(f"image {image} is missing and no build block is configured")
        if not os.path.isfile(containerfile):
            die(f"containerfile not found: {containerfile}")

        uid = id_output("-u")
        gid = id_output("-g")
        username = id_output("-un")
        build_flags: list[str] = [
            "--build-arg",
            f"USER_UID={uid}",
            "--build-arg",
            f"USER_GID={gid}",
            "--build-arg",
            f"USERNAME={username}",
        ]
        build_args = build_config.get("args")
        if build_args is None or build_args is False:
            build_args = {}
        if not isinstance(build_args, dict):
            die("build.args must be an object")
        for key, value in build_args.items():
            if not isinstance(value, str):
                die(f"build.arg {key} must be a string")
            build_flags += ["--build-arg", f"{key}={value}"]
        build_flags += [
            "--build-arg",
            f"LOCAL_PROVIDERS_SHA256={local_providers_sha}",
            "--label",
            f"{LOCAL_PROVIDERS_LABEL}={local_providers_sha}",
        ]

        tag_flags: list[str] = []
        for tag in image_tags:
            tag_flags += ["-t", tag]

        # flush=True: with a piped stdout this line must lead the build output.
        print(
            f"{PROG}: building {' '.join(image_tags)} "
            f"(containerfile {containerfile}, context {context})",
            flush=True,
        )
        proc = subprocess.run(
            [podman_executable(), "build", *build_flags, *tag_flags, "-f", containerfile, context],
            check=False,
        )
        if proc.returncode != 0:
            sys.exit(proc.returncode)

    if args.subcommand == "build":
        if args.force or not image_exists:
            print(f"{PROG}: built {' '.join(image_tags)}")
        else:
            print(f"{PROG}: image {image} already exists; pass --force to rebuild")
        sys.exit(0)

    # --- podman run flag assembly ----------------------------------------------
    run_flags: list[str] = [
        "--pull=never",
        "--rm",
        "--init",
        "--userns=keep-id",
        "--security-opt",
        "label=disable",
    ]

    if containers_enabled:
        uid = id_output("-u")
        gid = id_output("-g")
        socket_source = discover_container_socket(uid)
        if socket_source is None:
            die("containers is enabled, but no accessible Podman user or Docker socket was found")
        run_flags += ["-v", f"{socket_source}:{CONTAINER_SOCKET_TARGET}"]

        # Either engine can grant socket access through a supplementary host
        # group. Preserve memberships only when owner, primary-group, and world
        # permissions do not already explain this host user's read/write access.
        try:
            socket_stat: os.stat_result = os.stat(socket_source)
        except OSError:
            die(f"unable to inspect container-engine socket: {socket_source}")
        if (
            str(socket_stat.st_uid) != uid
            and str(socket_stat.st_gid) != gid
            and (stat.S_IMODE(socket_stat.st_mode) & 6) != 6
            and str(socket_stat.st_gid) in id_output("-G").split()
        ):
            run_flags += ["--group-add", "keep-groups"]

    # The pinned preview stores credentials and sessions under XDG data and UI
    # preferences under XDG state. Keep both isolated in one reusable named
    # volume.
    persistence = config.get("persistence")
    if persistence is not None and persistence is not False:
        if not isinstance(persistence, dict):
            die("persistence must be an object")
    else:
        persistence = {}
    data_volume = jq_or(persistence.get("data_volume"), f"opencode2-data-{project_key}")
    if not isinstance(data_volume, str):
        die("persistence.data_volume must be a string")
    if data_volume:
        if not VOLUME_NAME_RE.fullmatch(data_volume):
            die(f"invalid persistence.data_volume: {data_volume}")
        if containers_enabled and paths_overlap(container_workspace, OPENCODE_DATA_MOUNT):
            die(f"containers workspace {container_workspace} overlaps the OpenCode data mount")
        run_flags += [
            "-v",
            f"{data_volume}:{OPENCODE_DATA_MOUNT}:U",
            "-e",
            f"XDG_DATA_HOME={OPENCODE_DATA_MOUNT}",
            "-e",
            f"XDG_STATE_HOME={OPENCODE_DATA_MOUNT}/state",
        ]

    # TTY only when interactive (stdin and stdout are both a terminal).
    if sys.stdin.isatty() and sys.stdout.isatty():
        run_flags.append("-it")

    # Keep /src as a compatibility alias while running OpenCode2 from the
    # selected generated or host-identical project path.
    run_flags += [
        "-v",
        f"{workspace}:/src",
        "-v",
        f"{workspace}:{container_workspace}",
        "-w",
        workdir,
    ]
    if global_git_config is not None:
        run_flags += [
            "-v",
            f"{global_git_config}:{GLOBAL_GIT_CONFIG_TARGET}:ro",
            "-e",
            f"GIT_CONFIG_GLOBAL={GLOBAL_GIT_CONFIG_TARGET}",
        ]
    if global_router is not None:
        run_flags += [
            "-v",
            f"{global_router}:{ROUTER_GLOBAL_TARGET}:ro",
            "-e",
            f"OPENCODE_MODEL_ROUTER_GLOBAL_CONFIG={ROUTER_GLOBAL_TARGET}",
        ]
    if local_providers is not None:
        run_flags += [
            "-v",
            f"{local_providers[0]}:{LOCAL_PROVIDERS_TARGET}:ro",
        ]
    if config_present:
        run_flags += [
            "-v",
            f"{config_path}:{SANDBOX_TARGET}:ro",
            "-e",
            f"OPENCODE_MODEL_ROUTER_CONFIG={SANDBOX_TARGET}",
        ]

    # Network mode.
    network = jq_or(config.get("network"), "")
    if not isinstance(network, str):
        die("network must be a string")
    if network:
        run_flags += ["--network", network]

    # Capabilities.
    capabilities = config.get("capabilities")
    if capabilities is None or capabilities is False:
        capabilities = []
    if not isinstance(capabilities, list):
        die("capabilities must be an array")
    for capability in capabilities:
        if not isinstance(capability, str):
            die("capabilities entries must be strings")
        if capability:
            run_flags += ["--cap-add", capability]

    # Restricted runtime arguments: only a small allow-list of passthrough flags.
    runtime_args = config.get("runtime_args")
    if runtime_args is None or runtime_args is False:
        runtime_args = []
    if not isinstance(runtime_args, list):
        die("runtime_args must be an array")
    for arg in runtime_args:
        if not isinstance(arg, str):
            die("runtime_args entries must be strings")
        if not arg:
            continue
        if not arg.startswith(ALLOWED_RUNTIME_ARG_PREFIXES):
            die(f"runtime_args entry is not allowed: {arg}")
        run_flags.append(arg)

    # Additional mounts. Relative host sources resolve against the workspace; an
    # omitted target mirrors the resolved absolute source path.
    mounts = config.get("mounts")
    if mounts is None or mounts is False:
        mounts = []
    if not isinstance(mounts, list):
        die("mounts must be an array")
    for entry in mounts:
        if not isinstance(entry, dict):
            die("mount entries must be objects")
        source = entry.get("source")
        if not isinstance(source, str) or not source:
            die('mount entry missing "source"')
        if source.startswith("/"):
            source_path = source
        else:
            source_path = workspace + "/" + source
        if not os.path.exists(source_path):
            die(f"mount source does not exist: {source}")
        abs_source = os.path.realpath(source_path)
        if paths_overlap(abs_source, *host_state):
            die(f"mount source {abs_source} overlaps host OpenCode/.agents/.claude/.mcp state")
        if global_router is not None and paths_overlap(abs_source, global_router):
            die(f"mount source {abs_source} overlaps the user-global model-router config")
        if global_git_config is not None and paths_overlap(abs_source, global_git_config):
            die(f"mount source {abs_source} overlaps the user-global Git config")
        if local_providers is not None and paths_overlap(abs_source, local_providers[0]):
            die(f"mount source {abs_source} overlaps the local provider catalog")

        target = entry.get("target")
        if target is None or target is False:
            target = abs_source
        elif not isinstance(target, str):
            target = jq_string(target)
        if not target.startswith("/"):
            die(f"mount target must be absolute: {target}")
        target = os.path.realpath(target)
        if paths_overlap(target, *BAKED_ROOTS):
            die(f"mount target {target} shadows a baked config/plugin path")
        if containers_enabled and paths_overlap(target, container_workspace):
            die(
                f"mount target {target} overlaps the containers workspace mirror "
                f"{container_workspace}"
            )
        if containers_enabled and paths_overlap(target, CONTAINER_SOCKET_TARGET):
            die(f"mount target {target} shadows the managed container-engine socket")

        flag = f"{abs_source}:{target}"
        if jq_string(jq_or(entry.get("read_only"), False)) == "true":
            flag += ":ro"
        run_flags += ["-v", flag]

    # --- Environment -------------------------------------------------------------
    # Only provider vars that are actually set are forwarded, plus any
    # explicitly passed/set vars. Reserved names are rejected.
    secret_name_targets: dict[str, str] = {}
    for target_env, primary_secret, alternate_secret in PROVIDER_SECRET_SPECS:
        secret_name_targets[primary_secret] = target_env
        if alternate_secret:
            secret_name_targets[alternate_secret] = target_env

    # User-global Podman secrets are never injected into arbitrary projects merely
    # because they exist. A sandbox config must opt in by known secret name.
    secret_targets: dict[str, str] = {}
    provider_secrets = config.get("provider_secrets")
    if provider_secrets is None or provider_secrets is False:
        provider_secrets = []
    if not isinstance(provider_secrets, list):
        die("provider_secrets must be an array")
    for requested_secret in provider_secrets:
        if not isinstance(requested_secret, str):
            requested_secret = jq_string(requested_secret)
        if not requested_secret:
            continue
        env_target = secret_name_targets.get(requested_secret)
        if env_target is None:
            die(f"unknown provider_secrets entry: {requested_secret}")
        if env_target in secret_targets:
            die(f"multiple provider secrets target {env_target}")
        if not podman_quiet("secret", "exists", requested_secret):
            die(f"configured Podman secret does not exist: {requested_secret}")
        run_flags += ["--secret", f"{requested_secret},type=env,target={env_target}"]
        secret_targets[env_target] = requested_secret

    env_map: dict[str, str] = {}
    env_mode: dict[str, EnvMode] = {}

    def add_env(name: str, value: str, mode: EnvMode) -> None:
        if not ENV_NAME_RE.fullmatch(name):
            die(f"invalid environment variable name: {name}")
        if is_reserved_env_name(name):
            die(f"reserved environment variable: {name}")
        # A Podman secret is the less-exposed source and wins over inherited or
        # literal values targeting the same provider variable.
        if name in secret_targets:
            return
        env_map[name] = value
        env_mode[name] = mode

    for name in PROVIDER_ENV_VARS:
        if name in os.environ:
            add_env(name, "", "pass")

    env_config = config.get("env")
    if env_config is None or env_config is False:
        env_config = {}
    if not isinstance(env_config, dict):
        die("env must be an object")
    env_pass = env_config.get("pass")
    if env_pass is None or env_pass is False:
        env_pass = []
    if not isinstance(env_pass, list):
        die("env.pass must be an array")
    for name in env_pass:
        if not isinstance(name, str):
            die("env.pass entries must be strings")
        if not name:
            continue
        if is_reserved_env_name(name):
            die(f"reserved environment variable in env.pass: {name}")
        if name in os.environ:
            add_env(name, "", "pass")

    env_set = env_config.get("set")
    if env_set is None or env_set is False:
        env_set = {}
    if not isinstance(env_set, dict):
        die("env.set must be an object")
    for name, value in env_set.items():
        if not isinstance(value, str):
            die(f"env.set value for {name} must be a string")
        add_env(name, value, "set")

    if containers_enabled:
        # These values describe the launcher-managed socket and deliberately
        # override conflicting env.pass/env.set entries when container-engine
        # access is opted in.
        container_socket_uri = "unix://" + CONTAINER_SOCKET_TARGET
        add_env("CONTAINER_HOST", container_socket_uri, "set")
        add_env("DOCKER_HOST", container_socket_uri, "set")

    for name, mode in env_mode.items():
        if mode == "pass":
            # Let Podman inherit the value from this process without embedding a
            # secret in the visible command-line arguments.
            run_flags += ["-e", name]
        else:
            run_flags += ["-e", f"{name}={env_map[name]}"]

    # --- Linked worktree metadata --------------------------------------------------
    # Linked worktrees and submodules store a gitdir pointer in .git. Validate it
    # explicitly so stale metadata fails clearly instead of silently suppressing
    # the existing common-directory mount.
    git_file = workspace + "/.git"
    git_file_present = os.path.isfile(git_file)
    if git_file_present:
        try:
            with open(git_file, "rb") as handle:
                entry = handle.read().decode("utf-8", "replace")
        except OSError:
            die(f"unable to read linked-worktree git file: {git_file}")
        entry = entry.rstrip("\n")
        entry = entry.removesuffix("\r")
        if "\n" in entry or not entry.startswith("gitdir: "):
            die(f"malformed linked-worktree git file: {git_file}")
        git_dir_ref = entry.removeprefix("gitdir: ")
        if not git_dir_ref:
            die(f"linked-worktree git file has an empty gitdir: {git_file}")
        if git_dir_ref.startswith("/"):
            git_dir_path = git_dir_ref
        else:
            git_dir_path = workspace + "/" + git_dir_ref
        if not os.path.exists(git_dir_path):
            die(f"linked-worktree gitdir does not exist: {git_dir_ref}")
        git_dir_path = os.path.realpath(git_dir_path)
        if not os.path.isdir(git_dir_path):
            die(f"linked-worktree gitdir is not a directory: {git_dir_ref}")

    git_common_dir = ""
    git_common_ref = git_output(workspace, "rev-parse", "--git-common-dir")
    if git_common_ref is not None:
        git_common_ref = git_common_ref.rstrip("\n")
        if git_common_ref.startswith("/"):
            git_common_path = git_common_ref
        else:
            git_common_path = workspace + "/" + git_common_ref
        if os.path.exists(git_common_path):
            git_common_dir = os.path.realpath(git_common_path)
    elif git_file_present:
        die(f"unable to resolve linked-worktree common directory from {git_file}")

    if git_common_dir and not (
        git_common_dir == workspace or git_common_dir.startswith(workspace + "/")
    ):
        if paths_overlap(git_common_dir, *host_state):
            die(f"git metadata directory {git_common_dir} overlaps host OpenCode/.agents/.claude/.mcp state")
        if global_router is not None and paths_overlap(git_common_dir, global_router):
            die(f"git metadata directory {git_common_dir} overlaps the user-global model-router config")
        if global_git_config is not None and paths_overlap(git_common_dir, global_git_config):
            die(f"git metadata directory {git_common_dir} overlaps the user-global Git config")
        if local_providers is not None and paths_overlap(git_common_dir, local_providers[0]):
            die(f"git metadata directory {git_common_dir} overlaps the local provider catalog")
        if paths_overlap(git_common_dir, *BAKED_ROOTS):
            die(f"git metadata directory {git_common_dir} shadows a baked config/plugin path")
        if containers_enabled and paths_overlap(git_common_dir, container_workspace):
            die(f"git metadata directory {git_common_dir} overlaps the containers workspace mirror")
        if data_volume and paths_overlap(git_common_dir, OPENCODE_DATA_MOUNT):
            die(f"git metadata directory {git_common_dir} overlaps the OpenCode data mount")
        if containers_enabled and paths_overlap(git_common_dir, CONTAINER_SOCKET_TARGET):
            die(f"git metadata directory {git_common_dir} shadows the managed container-engine socket")
        run_flags += ["-v", f"{git_common_dir}:{git_common_dir}"]

    # --- Command selection ---------------------------------------------------------
    default_command: list[str] | None = None
    config_command = config.get("command")
    if config_command is None or config_command is False:
        config_command = []
    if not isinstance(config_command, list) or not all(
        isinstance(item, str) for item in config_command
    ):
        die("command must be an array of strings")
    if config_command:
        default_command = list(config_command)

    cmd: list[str]
    if args.subcommand == "shell":
        cmd = ["bash", "-l"]
    else:
        command_args = list(args.command_args or [])
        # A "--" directly before the command is the option separator, not part
        # of it.
        if command_args and command_args[0] == "--":
            command_args = command_args[1:]
        if command_args:
            cmd = command_args
        else:
            cmd = default_command if default_command is not None else list(DEFAULT_COMMAND)

    # --- Run ------------------------------------------------------------------------
    cleanup_temp_files()
    podman = podman_executable()
    os.execv(podman, [podman, "run", *run_flags, image, *cmd])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
