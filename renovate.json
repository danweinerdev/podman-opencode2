{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "Upstream repos pinned by commit in Containerfile ARGs, tracking each repo's branch",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: repo=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG \\w+_REF=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "description": "The OpenCode2 CLI version: ARG OPENCODE2_VERSION in the Containerfile, its only pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG OPENCODE2_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@opencode/cli"
    }
  ],
  "packageRules": [
    {
      "description": "One weekly PR for the four upstream commit pins",
      "matchDatasources": [
        "git-refs"
      ],
      "groupName": "sandbox upstream pins",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Only stable OpenCode releases, never beta/dev tags",
      "matchDepNames": [
        "@opencode/cli"
      ],
      "ignoreUnstable": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**"
  ]
}
