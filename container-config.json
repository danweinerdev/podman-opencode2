{
  "$schema": "./container-config.schema.json",
  "share": "disabled",
  "autoupdate": false,
  "default_agent": "aid-orchestrator",
  "permissions": [
    { "action": "external_directory", "resource": "/opt/opencode/sandbox/*", "effect": "allow" },
    { "action": "read", "resource": "/opt/opencode/sandbox/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/opencode/plugins/*", "effect": "allow" },
    { "action": "read", "resource": "/opt/opencode/plugins/*", "effect": "allow" }
  ],
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "skills": [
    "/opt/opencode/plugins/code-graph/skills",
    "/opt/opencode/plugins/debug/skills",
    "/opt/opencode/plugins/search/skills",
    "/opt/opencode/plugins/sandbox/skills"
  ],
  "mcp": {
    "servers": {
      "code-graph": {
        "type": "local",
        "command": ["/opt/mcp/bin/code-graph-mcp"],
        "disabled": false
      },
      "debug": {
        "type": "local",
        "command": ["/opt/mcp/bin/debug-mcp"],
        "disabled": false
      },
      "search": {
        "type": "local",
        "command": ["/opt/mcp/bin/search-mcp"],
        "disabled": false
      }
    }
  },
  "plugins": [
    {
      "package": "file:///opt/opencode/plugins/ai-devtools"
    }
  ]
}
