{
  "schema_version": 1,
  "image": "opencode2:latest",
  "build": {
    "containerfile": "Containerfile",
    "context": ".",
    "args": {
      "OPENCODE2_VERSION": "2.2.6"
    }
  },
  "workspace": ".",
  "containers": "nested",
  "mounts": [],
  "agents": ".agents",
  "env": {
    "pass": ["GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL"],
    "set": {
      "TZ": "UTC"
    }
  },
  "provider_secrets": ["openai-api-key", "deepseek-api-key"],
  "persistence": {
    "data_volume": "my-project-opencode2-data"
  },
  "network": "slirp4netns",
  "capabilities": ["NET_RAW"],
  "runtime_args": [
    "--add-host=host.containers.internal:host-gateway",
    "--pids-limit=2048",
    "--ulimit=nofile=65536:65536"
  ],
  "command": ["opencode2", "--standalone"]
}
