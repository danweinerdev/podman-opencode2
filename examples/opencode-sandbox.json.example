{
  "schema_version": 1,
  "image": "opencode2:latest",
  "build": {
    "containerfile": "Containerfile",
    "context": ".",
    "args": {
      "OPENCODE2_VERSION": "0.0.0-beta-17823"
    }
  },
  "workspace": ".",
  "containers": false,
  "mounts": [],
  "env": {
    "pass": ["GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL"],
    "set": {
      "TZ": "UTC"
    }
  },
  "provider_secrets": ["openai-api-key", "deepseek-api-key"],
  "persistence": {
    "data_volume": "my-project-opencode2-data"
  },
  "model_router": {
    "schema_version": 1,
    "profiles": {
      "reasoning": { "model": "anthropic/claude-opus-4-1", "variant": "high" }
    },
    "agents": {
      "reasoner": "reasoning",
      "implementer": "implementation"
    }
  },
  "network": "slirp4netns",
  "capabilities": ["SYS_PTRACE"],
  "runtime_args": [
    "--add-host=host.containers.internal:host-gateway",
    "--pids-limit=2048",
    "--ulimit=nofile=65536:65536"
  ],
  "command": ["opencode2", "--standalone"]
}
